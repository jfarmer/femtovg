[package]
name = "logos_wasm"
version = "0.0.0"
edition = "2021"
publish = false

[lib]
crate-type = ["cdylib"]
path = "src/lib.rs"

[dependencies]
femtovg = { path = "@FEMTOVG_SRC@", features = ["wgpu"] }
wgpu = { version = "30.0.0", features = ["webgl"] }
usvg = "0.48.1"
# femtovg takes `image` without codecs; the native harness gets PNG and JPEG through femtovg's dev-dependencies.
image = { version = "0.25.0", default-features = false, features = ["jpeg", "png"] }
pollster = "1.0"
wasm-bindgen = "=0.2.129"
wasm-bindgen-futures = "0.4.45"
js-sys = "0.3"
web-sys = { version = "0.3", features = ["console", "Window", "Performance", "Document", "Element", "HtmlCanvasElement"] }
console_error_panic_hook = "0.1.5"

[profile.release]
debug = false
codegen-units = 16

# Built outside any workspace.
[workspace]
