+/// The mask each fill of a flush carried.
+#[cfg(test)]
+fn drawn_masks(commands: &[Command]) -> Vec<Option<MaskCoverage>> {
+    commands
+        .iter()
+        .filter_map(|cmd| match &cmd.cmd_type {
+            CommandType::ConvexFill { params }
+            | CommandType::ConcaveFill {
+                fill_params: params, ..
+            } => Some(params.clip_mask),
+            _ => None,
+        })
+        .collect()
+}
