+/// Blurred siblings draw into one capture. A lone blur's result carries its
+/// capture's flags, so the two share a pool bucket; were the newest free
+/// image to serve whatever came next, each layer's capture would be the last
+/// one's result, and both images would be render targets where one is.
+#[test]
+fn filtered_siblings_draw_into_one_capture() {
+    use crate::ImageFilter;
+    use renderer::CommandType;
+    let mut canvas = Canvas::new(RecordingRenderer::default()).unwrap();
+    canvas.set_size(64, 64, 1.0);
+    let blur = LayerEffects::new().with_filters(&[ImageFilter::gaussian_blur(2.0)]);
+    let mut pairs = Vec::new();
+    for _ in 0..4 {
+        assert!(canvas.begin_layer(&blur));
+        let layer = canvas.layers.last().unwrap();
+        let (capture, result) = (layer.image.unwrap(), layer.filter_images.as_ref().unwrap().target);
+        assert_eq!(canvas.images.info(capture), canvas.images.info(result));
+        pairs.push((capture, result));
+        canvas.end_layer();
+    }
+    assert!(pairs.iter().all(|pair| *pair == pairs[0]), "{pairs:?}");
+    let drawn_into: HashSet<ImageId> = canvas
+        .commands
+        .iter()
+        .filter_map(|command| match command.cmd_type {
+            CommandType::SetRenderTarget(RenderTarget::Image(id)) => Some(id),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(drawn_into.len(), 1);
+}
