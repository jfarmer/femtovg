+/// Blurred shadows of one size draw their coverage into one image: the
+/// blurred image carries the coverage's flags, and still each goes back to
+/// the use it had.
+#[test]
+fn shadows_of_one_size_draw_into_one_coverage_image() {
+    use renderer::CommandType;
+    let renderer = RecordingRenderer::default();
+    let recorded = renderer.last_commands.clone();
+    let mut canvas = Canvas::new(renderer).unwrap();
+    canvas.set_size(64, 64, 1.0);
+    canvas.set_shadow_color(Color::rgba(0, 0, 0, 255));
+    canvas.set_shadow_blur(6.0);
+    let mut rect = Path::new();
+    rect.rect(10.0, 10.0, 30.0, 30.0);
+    for _ in 0..4 {
+        canvas.fill_path(&rect, &Paint::color(Color::rgb(255, 0, 0)));
+    }
+    canvas.flush_to_output(());
+    let drawn_into: HashSet<ImageId> = recorded
+        .borrow()
+        .iter()
+        .filter_map(|command| match command.cmd_type {
+            CommandType::SetRenderTarget(RenderTarget::Image(id)) => Some(id),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(drawn_into.len(), 1);
+}
