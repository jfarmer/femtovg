+/// Anatomy probe: counts Rust heap allocations per frame (PROBE_ALLOC=1 prints them).
+mod probe_alloc {
+    use std::alloc::{GlobalAlloc, Layout, System};
+    use std::sync::atomic::{AtomicI64, AtomicU64, Ordering::Relaxed};
+    pub static ALLOCS: AtomicU64 = AtomicU64::new(0);
+    pub static BYTES: AtomicU64 = AtomicU64::new(0);
+    pub static LIVE: AtomicI64 = AtomicI64::new(0);
+    pub static PEAK: AtomicI64 = AtomicI64::new(0);
+    pub struct Counting;
+    unsafe impl GlobalAlloc for Counting {
+        unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+            ALLOCS.fetch_add(1, Relaxed);
+            BYTES.fetch_add(l.size() as u64, Relaxed);
+            let live = LIVE.fetch_add(l.size() as i64, Relaxed) + l.size() as i64;
+            PEAK.fetch_max(live, Relaxed);
+            unsafe { System.alloc(l) }
+        }
+        unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+            LIVE.fetch_sub(l.size() as i64, Relaxed);
+            unsafe { System.dealloc(p, l) }
+        }
+        unsafe fn realloc(&self, p: *mut u8, l: Layout, n: usize) -> *mut u8 {
+            ALLOCS.fetch_add(1, Relaxed);
+            BYTES.fetch_add(n as u64, Relaxed);
+            let d = n as i64 - l.size() as i64;
+            let live = LIVE.fetch_add(d, Relaxed) + d;
+            PEAK.fetch_max(live, Relaxed);
+            unsafe { System.realloc(p, l, n) }
+        }
+    }
+    #[global_allocator]
+    static A: Counting = Counting;
+    pub fn snap() -> (u64, u64, i64) {
+        (ALLOCS.load(Relaxed), BYTES.load(Relaxed), LIVE.load(Relaxed))
+    }
 }
 
