+    pub static REVERSED_POINTS: AtomicU64 = AtomicU64::new(0);
+    pub static SIDES_POINTS: AtomicU64 = AtomicU64::new(0);
+    pub static FAN_VERTS: AtomicU64 = AtomicU64::new(0);
+    pub static FILL_VERTS: AtomicU64 = AtomicU64::new(0);
+    pub static FRINGE_VERTS: AtomicU64 = AtomicU64::new(0);
+    pub static STROKES: AtomicU64 = AtomicU64::new(0);
+    pub static STROKE_POINTS: AtomicU64 = AtomicU64::new(0);
+    pub static STROKE_VERTS: AtomicU64 = AtomicU64::new(0);
+    pub static JOIN_POINTS: AtomicU64 = AtomicU64::new(0);
+    pub static BEVEL_POINTS: AtomicU64 = AtomicU64::new(0);
+    pub static CONVEX_FILLS: AtomicU64 = AtomicU64::new(0);
+    pub static FLUSH_VERTS: AtomicU64 = AtomicU64::new(0);
+    pub static FLUSHES: AtomicU64 = AtomicU64::new(0);
+    pub static MAX_FLUSH_VERTS: AtomicU64 = AtomicU64::new(0);
+    pub static DRAWABLES: AtomicU64 = AtomicU64::new(0);
+    pub static MAX_CACHE_POINTS: AtomicU64 = AtomicU64::new(0);
+    pub fn add(c: &AtomicU64, n: usize) {
+        c.fetch_add(n as u64, Relaxed);
+    }
+    pub fn max(c: &AtomicU64, n: usize) {
+        c.fetch_max(n as u64, Relaxed);
+    }
+    pub fn report() {
+        let all = [
+            ("caches", &CACHES), ("points", &POINTS), ("contours", &CONTOURS), ("beziers", &BEZIERS),
+            ("tess_calls", &TESS_CALLS), ("dup_points", &DUP_POINTS), ("fills", &FILLS), ("fill_points", &FILL_POINTS),
+            ("fill_contours", &FILL_CONTOURS), ("reversed_points", &REVERSED_POINTS), ("sides_points", &SIDES_POINTS),
+            ("fan_verts", &FAN_VERTS), ("fill_verts", &FILL_VERTS), ("fringe_verts", &FRINGE_VERTS),
+            ("strokes", &STROKES), ("stroke_points", &STROKE_POINTS), ("stroke_verts", &STROKE_VERTS),
+            ("join_points", &JOIN_POINTS), ("bevel_points", &BEVEL_POINTS), ("convex_fills", &CONVEX_FILLS),
+            ("flush_verts", &FLUSH_VERTS), ("flushes", &FLUSHES), ("max_flush_verts", &MAX_FLUSH_VERTS),
+            ("drawables", &DRAWABLES), ("max_cache_points", &MAX_CACHE_POINTS),
+        ];
+        let mut line = String::from("PROBE");
+        for (name, c) in all {
+            line += &format!(" {name}={}", c.load(Relaxed));
+        }
+        line += &format!(
+            " size_point={} size_contour={} size_vertex={} size_pathcache={} size_drawable={} size_command={}",
+            std::mem::size_of::<super::Point>(),
+            std::mem::size_of::<super::Contour>(),
+            std::mem::size_of::<crate::renderer::Vertex>(),
+            std::mem::size_of::<super::PathCache>(),
+            std::mem::size_of::<crate::renderer::Drawable>(),
+            std::mem::size_of::<crate::renderer::Command>(),
+        );
+        eprintln!("{line}");
+    }
+}
