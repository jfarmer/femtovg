+/// Anatomy probe: user+kernel instructions and cycles per pass from the thread's own counters
+/// (thread_selfcounts, the recount API), less the cost of reading them. FEMTOVG_PASSES=1 turns it on.
+pub mod passes {
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering::Relaxed};
+    extern "C" {
+        fn thread_selfcounts(kind: i32, buf: *mut u64, nbytes: usize) -> i32;
+    }
+    pub const NAMES: [&str; 26] = [
+        "new_flatten", "new_contour_pass", "new_collinear", "fill_holes", "fill_orient", "fill_joins", "fill_reserve",
+        "fill_fan", "fill_tris", "fill_fringe", "fill_restore", "stroke_joins", "stroke_expand", "canvas_fill_total",
+        "canvas_fill_cache", "canvas_fill_clip", "canvas_fill_expand", "canvas_fill_copy", "canvas_stroke_total",
+        "canvas_stroke_cache", "canvas_stroke_expand", "canvas_stroke_copy", "flush_render", "write_buffer",
+        "flush_total", "spare",
+    ];
+    static INSTR: [AtomicU64; 26] = [const { AtomicU64::new(0) }; 26];
+    static CYC: [AtomicU64; 26] = [const { AtomicU64::new(0) }; 26];
+    static CALLS: [AtomicU64; 26] = [const { AtomicU64::new(0) }; 26];
+    static READS: AtomicU64 = AtomicU64::new(0);
+    static ON: AtomicBool = AtomicBool::new(false);
+    static INIT: std::sync::Once = std::sync::Once::new();
+    static O_INSTR: AtomicU64 = AtomicU64::new(0);
+    static O_CYC: AtomicU64 = AtomicU64::new(0);
+    #[inline(never)]
+    fn read() -> (u64, u64) {
+        let mut b = [0u64; 2];
+        unsafe { thread_selfcounts(1, b.as_mut_ptr(), 16) };
+        READS.fetch_add(1, Relaxed);
+        (b[0], b[1])
+    }
+    fn init() {
+        INIT.call_once(|| {
+            if std::env::var_os("FEMTOVG_PASSES").is_none() {
+                return;
+            }
+            let mut di = Vec::new();
+            let mut dc = Vec::new();
+            for _ in 0..401 {
+                let a = read();
+                let b = read();
+                di.push(b.0 - a.0);
+                dc.push(b.1 - a.1);
+            }
+            di.sort();
+            dc.sort();
+            O_INSTR.store(di[200], Relaxed);
+            O_CYC.store(dc[200], Relaxed);
+            ON.store(true, Relaxed);
+        });
+    }
+    pub struct Span(u64, u64, u64);
+    #[inline]
+    pub fn start() -> Option<Span> {
+        init();
+        if !ON.load(Relaxed) {
+            return None;
+        }
+        let r = READS.load(Relaxed);
+        let (i, c) = read();
+        Some(Span(i, c, r))
+    }
+    #[inline]
+    pub fn end(span: Option<Span>, id: usize) {
+        if let Some(Span(i0, c0, r0)) = span {
+            let (i1, c1) = read();
+            // reads made inside the span, besides its own two, each cost one read's worth
+            let nested = READS.load(Relaxed) - r0 - 2;
+            let k = 1 + nested;
+            INSTR[id].fetch_add((i1 - i0).saturating_sub(k * O_INSTR.load(Relaxed)), Relaxed);
+            CYC[id].fetch_add((c1 - c0).saturating_sub(k * O_CYC.load(Relaxed)), Relaxed);
+            CALLS[id].fetch_add(1, Relaxed);
+        }
+    }
+    pub fn reset() {
+        for i in 0..26 {
+            INSTR[i].store(0, Relaxed);
+            CYC[i].store(0, Relaxed);
+            CALLS[i].store(0, Relaxed);
+        }
+    }
+    pub fn report() {
+        if !ON.load(Relaxed) {
+            return;
+        }
+        let mut line = format!("PASSES o_instr={} o_cyc={}", O_INSTR.load(Relaxed), O_CYC.load(Relaxed));
+        for (i, n) in NAMES.iter().enumerate() {
+            line += &format!(
+                " {n}={}/{}/{}",
+                CALLS[i].load(Relaxed),
+                INSTR[i].load(Relaxed),
+                CYC[i].load(Relaxed)
+            );
+        }
+        eprintln!("{line}");
+    }
+}
+
+fn tris_loop() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("FEMTOVG_TRIS_LOOP").is_some())
+}
+
