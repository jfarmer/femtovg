+/// Anatomy probe: zero the per-pass counters (after a warm-up frame).
+#[doc(hidden)]
+pub fn probe_passes_reset() {
+    crate::path::cache::passes::reset();
+}
+
+/// Anatomy probe: FEMTOVG_TESS_TOL overrides the flattening tolerance (0.25).
+fn probe_tess_tol() -> f32 {
+    std::env::var("FEMTOVG_TESS_TOL").ok().and_then(|v| v.parse().ok()).unwrap_or(0.25)
+}
+
 impl<T: Renderer> Drop for Canvas<T> {
     fn drop(&mut self) {
+        if std::env::var_os("FEMTOVG_PROBE").is_some() {
+            crate::path::cache::probe::report();
+        }
+        crate::path::cache::passes::report();
         self.images.clear(&mut self.renderer);
     }
 }
