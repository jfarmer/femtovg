diff --git a/src/renderer.rs b/src/renderer.rs
index ecfeb8f..a06ea4b 100644
--- a/src/renderer.rs
+++ b/src/renderer.rs
@@ -149,6 +149,32 @@ impl Command {
             composite_operation: CompositeOperationState::default(),
         }
     }
+
+    /// The pixels a coverage mask leaves the command's draws - x, y, width
+    /// and height from the target's top left - when they are under one.
+    /// Outside them the mask is empty, so the renderer scissors every draw
+    /// of the command to them, the ones that only write the stencil too: a
+    /// fragment out there is not shaded, and a tiler leaves its tile alone,
+    /// as a clip on the stencil would have.
+    pub(crate) fn clip_bounds(&self) -> Option<[u32; 4]> {
+        let params = match &self.cmd_type {
+            CommandType::ConvexFill { params }
+            | CommandType::Stroke { params }
+            | CommandType::Triangles { params }
+            | CommandType::ConcaveFill {
+                fill_params: params, ..
+            }
+            | CommandType::StencilStroke { params1: params, .. } => params,
+            _ => return None,
+        };
+        let mask = params.clip_mask?;
+        Some([
+            mask.origin[0] as u32,
+            mask.origin[1] as u32,
+            mask.size[0] as u32,
+            mask.size[1] as u32,
+        ])
+    }
 }
 
