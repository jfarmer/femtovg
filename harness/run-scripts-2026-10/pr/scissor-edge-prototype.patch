+    /// With no clip shape in force, the scissor a draw over `bounds` carries:
+    /// none when the scissor holds the draw whole, and none for an
+    /// antialiased upright rect under an upright scissor, which is filled as
+    /// the rect the two share - an edge the draw has in common with the
+    /// scissor is then antialiased once, by the draw.
+    fn scissor_alone(
+        &mut self,
+        bounds: impl FnOnce() -> Bounds,
+        fill: Option<(&Path, &Transform2D)>,
+    ) -> (Option<ClipCoverage>, Scissor, Option<RoundedBox>) {
+        let scissor = self.state().scissor;
+        let Some(extent) = scissor.extent else {
+            return (None, scissor, None);
+        };
+        let boxed = match self.last_scissor_box {
+            Some((last, boxed)) if last == scissor => boxed,
+            _ => {
+                let scissor_box = RoundedBox {
+                    frame: scissor.transform,
+                    extent,
+                    radii: [scissor.radius; 2],
+                };
+                let boxed = scissor_box.coverage(self.fringe_width).map(|coverage| (scissor_box, coverage));
+                self.last_scissor_box = Some((scissor, boxed));
+                boxed
+            }
+        };
+        let Some((scissor_box, coverage)) = boxed else {
+            return (None, scissor, None);
+        };
+        if coverage.holds(&bounds()) {
+            return (None, Scissor::default(), None);
+        }
+        match fill.and_then(|(path, transform)| scissor_box.shared_rect(path, transform, self.fringe_width)) {
+            Some(rect) => (None, Scissor::default(), Some(rect)),
+            None => (None, scissor, None),
+        }
+    }
