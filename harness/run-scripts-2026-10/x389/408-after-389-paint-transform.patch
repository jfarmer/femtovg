 #[cfg(feature = "textlayout")]
+#[test]
+fn thin_text_drawn_through_masks_uses_one_paint_matrix_for_the_run() {
+    use renderer::CommandType;
+
+    let renderer = RecordingRenderer::default();
+    let recorded = renderer.last_commands.clone();
+    let mut canvas = Canvas::new(renderer).unwrap();
+    canvas.set_size(400, 400, 1.0);
+    let font = canvas
+        .add_font_mem(include_bytes!("../examples/assets/RobotoFlex-VariableFont.ttf"))
+        .expect("failed to load test font");
+    canvas.scale(2.0, 2.0);
+    let paint = Paint::linear_gradient(0.0, 0.0, 100.0, 0.0, Color::black(), Color::white());
+    let mut path = Path::new();
+    path.circle(50.0, 50.0, 40.0);
+    canvas.fill_path(&path, &paint);
+    canvas
+        .fill_text(10.0, 40.0, "MI", &paint.clone().with_font(&[font]).with_font_size(3.0))
+        .unwrap();
+    canvas.flush_to_output(());
+
+    let commands = recorded.borrow();
+    let mut matrices = Vec::new();
+    for command in commands.iter() {
+        match &command.cmd_type {
+            CommandType::ConvexFill { params } => matrices.push(("convex", params.paint_mat)),
+            CommandType::ConcaveFill { fill_params, .. } => matrices.push(("concave", fill_params.paint_mat)),
+            CommandType::Triangles { params } => matrices.push(("triangles", params.paint_mat)),
+            _ => {}
+        }
+    }
+    eprintln!("{matrices:?}");
+    assert!(matrices.len() >= 2 && matrices.iter().any(|(kind, _)| *kind == "triangles"), "{matrices:?}");
+    assert!(matrices.iter().all(|(_, matrix)| *matrix == matrices[0].1), "{matrices:?}");
+}
