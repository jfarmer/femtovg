+// TEMPORARY instrumentation (never committed): what memos of several sizes and policies would catch.
+struct MemoSim {
+    calls: usize,
+    lookups: usize,
+    distinct: Vec<PipelineState>,
+    fifo: Vec<(usize, Vec<PipelineState>, usize, usize)>,
+    lru: Vec<(usize, Vec<PipelineState>, usize)>,
+    uniform_builds: usize,
+    uniform_stages: usize,
+}
+
+impl MemoSim {
+    fn new() -> Self {
+        let sizes = [1usize, 2, 3, 4, 6, 8, 12, 16];
+        Self {
+            calls: 0,
+            lookups: 0,
+            distinct: Vec::new(),
+            fifo: sizes.iter().map(|&n| (n, Vec::new(), 0, 0)).collect(),
+            lru: sizes.iter().map(|&n| (n, Vec::new(), 0)).collect(),
+            uniform_builds: 0,
+            uniform_stages: 0,
+        }
+    }
+
+    fn lookup(&mut self, s: &PipelineState) {
+        self.lookups += 1;
+        if !self.distinct.contains(s) {
+            self.distinct.push(s.clone());
+        }
+        for (n, entries, next, hits) in &mut self.fifo {
+            if entries.contains(s) {
+                *hits += 1;
+            } else if entries.len() < *n {
+                entries.push(s.clone());
+            } else {
+                entries[*next] = s.clone();
+                *next = (*next + 1) % *n;
+            }
+        }
+        for (n, entries, hits) in &mut self.lru {
+            if let Some(i) = entries.iter().position(|e| e == s) {
+                *hits += 1;
+                let e = entries.remove(i);
+                entries.insert(0, e);
+            } else {
+                if entries.len() == *n {
+                    entries.pop();
+                }
+                entries.insert(0, s.clone());
+            }
+        }
+    }
+
+    fn report(&self) {
+        if std::env::var_os("PIPELINE_MEMO_STATS").is_none() {
+            return;
+        }
+        let fifo: Vec<String> = self.fifo.iter().map(|(n, _, _, h)| format!("{n}:{h}")).collect();
+        let lru: Vec<String> = self.lru.iter().map(|(n, _, h)| format!("{n}:{h}")).collect();
+        eprintln!(
+            "MEMOSIM calls={} lookups={} distinct={} uniform_builds={} uniform_stages={} fifo={} lru={}",
+            self.calls,
+            self.lookups,
+            self.distinct.len(),
+            self.uniform_builds,
+            self.uniform_stages,
+            fifo.join(","),
+            lru.join(",")
+        );
+    }
+}
