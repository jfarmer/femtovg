+// TEMPORARY instrumentation (never committed): nanoseconds spent in the per-frame setup calls.
+pub(crate) mod fs_time {
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    pub static RENDER: AtomicU64 = AtomicU64::new(0);
+    pub static VIEWPORT: AtomicU64 = AtomicU64::new(0);
+    pub static VIEWPORT_N: AtomicU64 = AtomicU64::new(0);
+    pub static WRITE_VERTEX: AtomicU64 = AtomicU64::new(0);
+    pub static WRITE_INDEX: AtomicU64 = AtomicU64::new(0);
+    pub static WRITE_UNIFORM: AtomicU64 = AtomicU64::new(0);
+    pub static FINISH: AtomicU64 = AtomicU64::new(0);
+    pub static RENDERS: AtomicU64 = AtomicU64::new(0);
+    pub fn add(c: &AtomicU64, since: std::time::Instant) {
+        c.fetch_add(since.elapsed().as_nanos() as u64, Relaxed);
+    }
+    pub fn report() {
+        if std::env::var_os("FS_TIME").is_none() {
+            return;
+        }
+        let n = RENDERS.load(Relaxed).max(1) as f64;
+        let us = |c: &AtomicU64| c.load(Relaxed) as f64 / n / 1000.0;
+        eprintln!(
+            "FSTIME renders={} render_us={:.2} viewport_us={:.2} viewport_n={:.1} write_vertex_us={:.2} write_index_us={:.2} write_uniform_us={:.2} finish_us={:.2}",
+            n, us(&RENDER), us(&VIEWPORT), VIEWPORT_N.load(Relaxed) as f64 / n, us(&WRITE_VERTEX), us(&WRITE_INDEX), us(&WRITE_UNIFORM), us(&FINISH)
+        );
+    }
+}
