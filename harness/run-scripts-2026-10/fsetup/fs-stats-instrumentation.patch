+// TEMPORARY instrumentation (never committed).
+pub(crate) mod fs_stats {
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    pub static VIEWPORT_GROUPS: AtomicU64 = AtomicU64::new(0);
+    pub static PASSES: AtomicU64 = AtomicU64::new(0);
+    pub static STAGING_GROWS: AtomicU64 = AtomicU64::new(0);
+    pub static UNIFORM_BYTES: AtomicU64 = AtomicU64::new(0);
+    pub static VERTEX_BYTES: AtomicU64 = AtomicU64::new(0);
+    pub static INDEX_BYTES: AtomicU64 = AtomicU64::new(0);
+    pub static RENDERS: AtomicU64 = AtomicU64::new(0);
+    pub static COMMANDS: AtomicU64 = AtomicU64::new(0);
+    pub static DISTINCT: AtomicU64 = AtomicU64::new(0);
+    thread_local! {
+        pub static SIZES: std::cell::RefCell<Vec<[u32; 2]>> = const { std::cell::RefCell::new(Vec::new()) };
+    }
+    pub fn size(v: [f32; 2]) {
+        SIZES.with(|s| {
+            let k = [v[0] as u32, v[1] as u32];
+            let mut s = s.borrow_mut();
+            if !s.contains(&k) {
+                s.push(k);
+            }
+        });
+    }
+    pub fn end_frame() {
+        SIZES.with(|s| {
+            let mut s = s.borrow_mut();
+            DISTINCT.store(s.len() as u64, Relaxed);
+            s.clear();
+        });
+    }
+    pub fn add(c: &AtomicU64, n: u64) {
+        c.fetch_add(n, Relaxed);
+    }
+    pub fn report() {
+        if std::env::var_os("FS_STATS").is_none() {
+            return;
+        }
+        let g = |c: &AtomicU64| c.load(Relaxed);
+        eprintln!(
+            "FSSTATS distinct_sizes={} renders={} commands={} viewport_groups={} passes={} staging_grows={} uniform_bytes={} vertex_bytes={} index_bytes={}",
+            g(&DISTINCT), g(&RENDERS), g(&COMMANDS), g(&VIEWPORT_GROUPS), g(&PASSES), g(&STAGING_GROWS), g(&UNIFORM_BYTES), g(&VERTEX_BYTES), g(&INDEX_BYTES)
+        );
+    }
+}
