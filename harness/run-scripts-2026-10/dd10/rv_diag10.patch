+fn rv_bbox(points: &[Point]) -> (f32, f32, f32, f32) {
+    points.iter().fold((f32::MAX, f32::MAX, f32::MIN, f32::MIN), |b, p| {
+        (b.0.min(p.pos.x), b.1.min(p.pos.y), b.2.max(p.pos.x), b.3.max(p.pos.y))
+    })
