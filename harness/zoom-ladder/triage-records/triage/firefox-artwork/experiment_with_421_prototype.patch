+/// Where the inner points of a round cap's or join's fan go. The fan's first and last points sit on the
+/// stroke's sides, `rim` from its centre, and along each ray from the centre the shader takes coverage from
+/// 1 to 0 over the outer `fringe / rim` of the way to the fan's edge, so a fan puts down `2 k` times its
+/// polygon's area, `k = 1/2 - t/2 + t^2/6` for `t = fringe / rim`: around an arc, more than the arc's area,
+/// and less where its chords cut inside. The inner points are placed for the fan to put down the area of the
+/// exact cap or join, a half disc or a sector of the stroke's own `width`, at the alpha a stroke thinner than
+/// the fringe is drawn at.
+struct RoundFan {
+    rim: f32,
+    k: f32,
+    area_per_radian: f32,
+}
+
+impl RoundFan {
+    fn new(rim: f32, fringe: f32, width: f32) -> Self {
+        let t = fringe / rim;
+        let drawn = 2.0 * rim - fringe;
+        let alpha = (width / drawn).min(1.0);
+        Self {
+            rim,
+            k: 0.5 - t / 2.0 + t * t / 6.0,
+            area_per_radian: if width > 0.0 { width * width / 8.0 / alpha } else { 0.0 },
+        }
+    }
+
+    /// The radius of the inner points of a fan of `chords` chords turning through `turn`.
+    fn inner_radius(&self, turn: f32, chords: usize) -> f32 {
+        if chords < 2 || self.area_per_radian <= 0.0 {
+            return self.rim;
+        }
+        // The polygon's area is (sin / 2) (2 rim r + m r^2), its first and last triangles reaching the rim.
+        let ink = self.area_per_radian * turn / self.k;
+        let sin = (turn / chords as f32).sin();
+        let m = (chords - 2) as f32;
+        if m == 0.0 {
+            ink / (2.0 * sin * self.rim)
+        } else {
+            ((self.rim * self.rim + m * ink / sin).sqrt() - self.rim) / m
+        }
+    }
+}
