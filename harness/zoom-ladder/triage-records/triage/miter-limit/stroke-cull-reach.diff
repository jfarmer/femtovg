+#[test]
+fn a_stroke_whose_width_reaches_the_canvas_from_a_centreline_off_it_is_drawn() {
+    // A horizontal line 20 px below the canvas, 60 px wide: rows 90..99 are covered.
+    let wide = strokes_drawn(|canvas| {
+        let mut path = Path::new();
+        path.move_to(0.0, 120.0);
+        path.line_to(100.0, 120.0);
+        canvas.stroke_path(&path, &Paint::color(Color::white()).with_line_width(60.0));
+    });
+    // A corner 10 px below the canvas whose miter tip (ratio 3.16, under the
+    // limit of 4) reaches 31.6 px up from it, to y = 78.4.
+    let miter = strokes_drawn(|canvas| {
+        let mut path = Path::new();
+        path.move_to(20.0, 200.0);
+        path.line_to(50.0, 110.0);
+        path.line_to(80.0, 200.0);
+        canvas.stroke_path(
+            &path,
+            &Paint::color(Color::white()).with_line_width(20.0).with_miter_limit(4.0),
+        );
+    });
+    // Control: the same wide line, too far below to reach (bevel joins, so
+    // no miter can reach further than the half width).
+    let away = strokes_drawn(|canvas| {
+        let mut path = Path::new();
+        path.move_to(0.0, 140.0);
+        path.line_to(100.0, 140.0);
+        canvas.stroke_path(
+            &path,
+            &Paint::color(Color::white())
+                .with_line_width(60.0)
+                .with_line_join(LineJoin::Bevel),
+        );
+    });
+    assert_eq!((wide, miter, away), (1, 1, 0));
+}
