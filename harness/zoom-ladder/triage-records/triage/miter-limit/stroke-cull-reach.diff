+        // Early out if the stroke is outside the canvas bounds. The cache's
+        // bounds cover only the centreline; the stroke reaches past them by
+        // its half width (further at a miter tip or square cap) plus the
+        // antialiasing fringe.
+        let cull_width = (stroke.line_width * transform.average_scale()).max(self.fringe_width);
+        let cull_reach = stroke.reach(cull_width) + self.fringe_width;
+        if path_cache.bounds.maxx + cull_reach < 0.0
+            || path_cache.bounds.minx - cull_reach > self.width() as f32
+            || path_cache.bounds.maxy + cull_reach < 0.0
