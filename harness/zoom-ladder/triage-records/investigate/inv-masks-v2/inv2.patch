+pub(crate) mod inv2 {
+    use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+    use std::sync::OnceLock;
+    pub static THIN: AtomicUsize = AtomicUsize::new(0);
+    pub static ASKED_HIT: AtomicUsize = AtomicUsize::new(0);
+    pub static KEY_HIT: AtomicUsize = AtomicUsize::new(0);
+    pub static MADE: AtomicUsize = AtomicUsize::new(0);
+    pub static REFUSED: AtomicUsize = AtomicUsize::new(0);
+    pub static FRAME: AtomicUsize = AtomicUsize::new(0);
+    pub fn cap() -> usize {
+        static C: OnceLock<usize> = OnceLock::new();
+        *C.get_or_init(|| std::env::var("INV2_CAP").ok().and_then(|v| v.parse().ok()).unwrap_or(super::MASKS_A_FRAME))
+    }
+    pub fn no_motion() -> bool {
+        static C: OnceLock<bool> = OnceLock::new();
+        *C.get_or_init(|| std::env::var_os("INV2_NO_MOTION").is_some())
+    }
+    pub static DRAWN: AtomicUsize = AtomicUsize::new(0);
+    pub fn key_first() -> bool {
+        static C: OnceLock<bool> = OnceLock::new();
+        *C.get_or_init(|| std::env::var_os("INV2_KEY_FIRST").is_some())
+    }
+    pub fn count_draws() -> bool {
+        static C: OnceLock<bool> = OnceLock::new();
+        *C.get_or_init(|| std::env::var_os("INV2_COUNT_DRAWS").is_some())
+    }
+    pub fn stats() -> bool {
+        static C: OnceLock<bool> = OnceLock::new();
+        *C.get_or_init(|| std::env::var_os("INV2_STATS").is_some())
+    }
+    pub fn take(c: &AtomicUsize) -> usize { c.swap(0, Relaxed) }
+    pub fn inc(c: &AtomicUsize) { c.fetch_add(1, Relaxed); }
+}
