+/// inv-masks-v1-v1 experiment switches and counters (env-gated; none set = master).
+pub(crate) mod v1 {
+    use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+    use std::sync::OnceLock;
+    pub(crate) static THIN: AtomicUsize = AtomicUsize::new(0);
+    pub(crate) static REQ: AtomicUsize = AtomicUsize::new(0);
+    pub(crate) static KEY: AtomicUsize = AtomicUsize::new(0);
+    pub(crate) static GATED: AtomicUsize = AtomicUsize::new(0);
+    pub(crate) static FRAME: AtomicUsize = AtomicUsize::new(0);
+    fn env_usize(name: &str) -> Option<usize> {
+        std::env::var(name).ok().and_then(|v| v.parse().ok())
+    }
+    pub(crate) fn cap() -> usize {
+        static C: OnceLock<usize> = OnceLock::new();
+        *C.get_or_init(|| env_usize("V1_CAP").unwrap_or(super::MASKS_A_FRAME))
+    }
+    pub(crate) fn no_motion() -> bool {
+        static C: OnceLock<bool> = OnceLock::new();
+        *C.get_or_init(|| std::env::var_os("V1_NO_MOTION").is_some())
+    }
+    pub(crate) fn key_first() -> bool {
+        static C: OnceLock<bool> = OnceLock::new();
+        *C.get_or_init(|| std::env::var_os("V1_KEY_FIRST").is_some())
+    }
+    pub(crate) fn stats() -> bool {
+        static C: OnceLock<bool> = OnceLock::new();
+        *C.get_or_init(|| std::env::var_os("V1_STATS").is_some())
+    }
+    pub(crate) fn bump(c: &AtomicUsize) {
+        c.fetch_add(1, Relaxed);
+    }
+    pub(crate) fn take(c: &AtomicUsize) -> usize {
+        c.swap(0, Relaxed)
+    }
+}
