+fn masks_a_frame() -> usize {
+    use std::sync::OnceLock;
+    static N: OnceLock<usize> = OnceLock::new();
+    *N.get_or_init(|| std::env::var("INV_MASKS_A_FRAME").ok().and_then(|v| v.parse().ok()).unwrap_or(MASKS_A_FRAME))
+}
+
+pub(crate) fn inv_flag(name: &str) -> bool {
+    std::env::var_os(name).is_some()
+}
+
+pub(crate) fn inv_stats() -> bool {
+    use std::sync::OnceLock;
+    static N: OnceLock<bool> = OnceLock::new();
+    *N.get_or_init(|| std::env::var_os("INV_MASK_STATS").is_some())
+}
