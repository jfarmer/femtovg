+
+/// inv-emoji repro: a PNG (sbix) glyph is drawn at its size, inside the quad's empty padding.
+/// The test font's only glyph is a 24 by 24 PNG of one colour in a 24 ppem strike with
+/// originOffset (0, 0), so at font size 48 the bitmap must cover x 50..98 and y 52..100
+/// (its bottom-left corner on the pen at (50, 100), sbix spec) - 48 by 48 pixels.
+#[cfg(all(feature = "textlayout", feature = "image-loading"))]
+#[test]
+fn inv_emoji_png_glyph_covers_its_size_inside_the_padding() {
+    use crate::paint::GlyphTexture;
+    use crate::text::test_fonts::png_glyph_font;
+
+    let mut renderer = RecordingRenderer::default();
+    renderer.retain_image_updates = true;
+    let recorded_commands = renderer.last_commands.clone();
+    let recorded_verts = renderer.last_verts.clone();
+    let text_context = TextContext::default();
+    let font = text_context.add_font_mem(&png_glyph_font()).unwrap();
+    let mut canvas = Canvas::new_with_text_context(renderer, text_context).unwrap();
+    canvas.set_size(400, 400, 1.0);
+    let paint = Paint::color(Color::black()).with_font_size(48.0);
+    canvas
+        .fill_glyph_run(font, &[], [PositionedGlyph { x: 50.0, y: 100.0, glyph_id: 0 }], &paint)
+        .unwrap();
+    // The upload, before the flush releases nothing (the main atlas persists).
+    let command_image = {
+        canvas.flush_to_output(());
+        let commands = recorded_commands.borrow();
+        let command = commands
+            .iter()
+            .find(|c| matches!(c.glyph_texture, GlyphTexture::ColorTexture(_)))
+            .expect("a colour glyph draw");
+        let (offset, count) = command.triangles_verts.unwrap();
+        let verts = &recorded_verts.borrow()[offset..offset + count];
+        eprintln!(
+            "quad: x {}..{} y {}..{}",
+            verts[0].x, verts[1].x, verts[0].y, verts[1].y
+        );
+        match command.glyph_texture {
+            GlyphTexture::ColorTexture(id) => id,
+            _ => unreachable!(),
+        }
+    };
+    let image = canvas.images.get(command_image).unwrap();
+    let (x, y, upload) = image.updates.last().expect("the bitmap's upload");
+    let opaque: Vec<(usize, usize)> = upload
+        .pixels()
+        .enumerate()
+        .filter(|(_, p)| p.a > 0)
+        .map(|(i, _)| (i % upload.width(), i / upload.width()))
+        .collect();
+    let (min_x, max_x) = (opaque.iter().map(|p| p.0).min().unwrap(), opaque.iter().map(|p| p.0).max().unwrap());
+    let (min_y, max_y) = (opaque.iter().map(|p| p.1).min().unwrap(), opaque.iter().map(|p| p.1).max().unwrap());
+    eprintln!(
+        "upload at ({x}, {y}): {}x{}, opaque texels x {min_x}..={max_x} y {min_y}..={max_y}",
+        upload.width(),
+        upload.height()
+    );
+    assert_eq!(
+        (max_x - min_x + 1, max_y - min_y + 1),
+        (48, 48),
+        "the 24 px strike at font size 48 should cover 48 by 48 texels, not the padded cell"
+    );
+}
