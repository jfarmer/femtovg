+fn probe_centre_lut(gradient: &MultiStopGradient, n: usize) -> imgref::Img<Vec<rgb::RGBA8>> {
+    let stops: Vec<GradientStop> = (0..gradient.len())
+        .map(|i| gradient.get(i))
+        .filter(|s| s.0 <= 1.0)
+        .collect();
+    let mut out = Vec::with_capacity(n);
+    for i in 0..n {
+        let t = (i as f32 + 0.5) / n as f32;
+        let k = stops.iter().filter(|s| t >= s.0).count();
+        let c = if k == 0 {
+            stops[0].1
+        } else if k >= stops.len() {
+            stops[stops.len() - 1].1
+        } else {
+            let (a, b) = (stops[k - 1], stops[k]);
+            let w = (t - a.0) / (b.0 - a.0);
+            Color::rgbaf(
+                a.1.r + (b.1.r - a.1.r) * w,
+                a.1.g + (b.1.g - a.1.g) * w,
+                a.1.b + (b.1.b - a.1.b) * w,
+                a.1.a + (b.1.a - a.1.a) * w,
+            )
+        };
+        let q = |v: f32| (v * 255.0).round().clamp(0.0, 255.0) as u8;
+        out.push(rgb::RGBA8::new(q(c.r * c.a), q(c.g * c.a), q(c.b * c.a), q(c.a)));
+    }
+    imgref::Img::new(out, n, 1)
+}
