+// SPIKE PROTOTYPE (env FV_SPIKE): 0 master, 1 any-of bevel test in expand_fill, 2 the extrusion of a point that is
+// not a beveled corner bounded to the miter limit, 3 every point's extrusion bounded to the miter limit.
+fn spike_mode() -> u8 {
+    static MODE: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    *MODE.get_or_init(|| std::env::var("FV_SPIKE").ok().and_then(|v| v.parse().ok()).unwrap_or(0))
+}
+
+fn spike_bound(p: &Point, miter_limit: f32) -> Point {
+    let mut q = *p;
+    let bounded = match spike_mode() {
+        2 => !p.flags.contains(PointFlags::BEVEL),
+        3 => true,
+        _ => false,
+    };
+    let m2 = p.dmpos.mag2();
+    if bounded && m2 > miter_limit * miter_limit {
+        q.dmpos = p.dmpos * (miter_limit / m2.sqrt());
+    }
+    q
+}
