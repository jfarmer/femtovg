+/// Finds the parameter at which `curve` has covered `target` arc length, resuming from a point behind it:
+/// `(t0, s0)` is a parameter and the arc length measured there. Glyph offsets normally ascend, so the
+/// previous glyph is such a point. Newton's method on the arc length of the short piece `t0..t`, with the
+/// speed `|B'(t)|` as the derivative, takes a step or two and never measures the whole curve again.
+/// Returns the parameter and the arc length there, or `None` (target behind `t0`, zero speed, no
+/// convergence) so that the caller can use `inv_arclen`.
+fn inv_arclen_resume(
+    curve: &kurbo::CubicBez,
+    t0: f64,
+    s0: f64,
+    target: f64,
+    accuracy: f64,
+) -> Option<(f64, f64)> {
+    let wanted = target - s0;
+    if wanted < 0.0 {
+        return None;
+    }
+    let deriv = curve.deriv();
+    let inner = accuracy * 0.25;
+    let (mut t, mut piece) = (t0, 0.0);
+    for _ in 0..6 {
+        let d = deriv.eval(t);
+        let speed = d.x.hypot(d.y);
+        if !speed.is_finite() || speed <= 1.0e-9 {
+            return None;
+        }
+        let err = piece - wanted;
+        if err.abs() <= inner {
+            return Some((t, s0 + piece));
+        }
+        let next = t - err / speed;
+        if !(t0..=1.0).contains(&next) {
+            return None;
+        }
+        t = next;
+        piece = curve.subsegment(t0..t).arclen(inner);
+    }
+    ((piece - wanted).abs() <= inner).then_some((t, s0 + piece))
+}
