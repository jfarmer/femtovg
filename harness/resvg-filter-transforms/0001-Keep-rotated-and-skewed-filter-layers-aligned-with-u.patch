diff --git a/crates/resvg/src/filter/mod.rs b/crates/resvg/src/filter/mod.rs
index 28f92f9..5939c12 100644
--- a/crates/resvg/src/filter/mod.rs
+++ b/crates/resvg/src/filter/mod.rs
@@ -362,7 +362,7 @@ fn apply_inner(
     let region = filter
         .rect()
         .transform(ts)
-        .map(|r| r.to_int_rect())
+        .and_then(crate::geom::to_int_rect)
         .ok_or(Error::InvalidRegion)?;
 
     // The source pixmap is clamped to `max_bbox` in `render_group`, so the filter
@@ -389,7 +389,7 @@ fn apply_inner(
         let mut subregion = primitive
             .rect()
             .transform(ts)
-            .map(|r| r.to_int_rect())
+            .and_then(crate::geom::to_int_rect)
             .ok_or(Error::InvalidRegion)?;
 
         // `feOffset` inherits its region from the input.
diff --git a/crates/resvg/src/geom.rs b/crates/resvg/src/geom.rs
index 8552708..22271dd 100644
--- a/crates/resvg/src/geom.rs
+++ b/crates/resvg/src/geom.rs
@@ -1,6 +1,18 @@
 // Copyright 2023 the Resvg Authors
 // SPDX-License-Identifier: Apache-2.0 OR MIT
 
+/// Converts a filter region into pixels, rounding its edges outwards, but taking an edge within
+/// a thousandth of a pixel of an integer as that integer, as Skia's image filters do, so that
+/// the float error of a transform does not add a row or a column of pixels.
+pub fn to_int_rect(r: tiny_skia::NonZeroRect) -> Option<tiny_skia::IntRect> {
+    const EPSILON: f32 = 1e-3;
+    let left = (r.left() + EPSILON).floor();
+    let top = (r.top() + EPSILON).floor();
+    let right = (r.right() - EPSILON).ceil().max(left + 1.0);
+    let bottom = (r.bottom() - EPSILON).ceil().max(top + 1.0);
+    tiny_skia::IntRect::from_ltrb(left as i32, top as i32, right as i32, bottom as i32)
+}
+
 /// Fits the current rect into the specified bounds.
 pub fn fit_to_rect(
     r: tiny_skia::IntRect,
diff --git a/crates/resvg/src/render.rs b/crates/resvg/src/render.rs
index ae9a87f..97998f0 100644
--- a/crates/resvg/src/render.rs
+++ b/crates/resvg/src/render.rs
@@ -59,25 +59,32 @@ fn render_group(
         return Some(());
     }
 
-    let rest = if group.filters().is_empty() {
-        tiny_skia::Transform::identity()
-    } else {
+    let mut rest = tiny_skia::Transform::identity();
+    let mut layer_ts = transform;
+    if !group.filters().is_empty() {
         let sx = transform.sx.hypot(transform.ky);
         let sy = transform.kx.hypot(transform.sy);
-        tiny_skia::Transform::from_row(
+        rest = tiny_skia::Transform::from_row(
             transform.sx / sx,
             transform.ky / sx,
             transform.kx / sy,
             transform.sy / sy,
             0.0,
             0.0,
-        )
-    };
+        );
+        if rest.has_skew() {
+            // A rotated or skewed layer takes the translation along and is scaled exactly,
+            // so that its pixels stay aligned with the group's user space, as in browsers.
+            rest = rest.post_translate(transform.tx, transform.ty);
+            layer_ts = tiny_skia::Transform::from_scale(sx, sy);
+        } else {
+            layer_ts = rest.invert()?.pre_concat(transform);
+        }
+    }
     let inv_rest = rest.invert()?;
 
     let max_bbox = ctx.max_bbox.to_rect().transform(inv_rest)?.round_out()?;
-    let (layer, ibbox) =
-        render_layer(group, &Context { max_bbox }, inv_rest.pre_concat(transform))?;
+    let (layer, ibbox) = render_layer(group, &Context { max_bbox }, layer_ts)?;
 
     let paint = tiny_skia::Paint {
         shader: tiny_skia::Pattern::new(
@@ -117,12 +124,7 @@ fn render_layer(
     } else {
         // The bounding box for groups with filters is special and should not be expanded by 2px,
         // because it's already acting as a clipping region.
-        let bbox = tiny_skia::IntRect::from_xywh(
-            bbox.x().floor() as i32,
-            bbox.y().floor() as i32,
-            bbox.width().ceil().max(1.0) as u32,
-            bbox.height().ceil().max(1.0) as u32,
-        )?;
+        let bbox = crate::geom::to_int_rect(bbox)?;
         // Make sure our filter region is not bigger than 4x the canvas size.
         // This is required mainly to prevent huge filter regions that would tank the performance.
         // It should not affect the final result in any way.
